{
  "family": "uptime-monitor-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "uptime-monitor",
      "image": "092426855023.dkr.ecr.us-east-1.amazonaws.com/uptime-monitor:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::092426855023:role/ecsTaskExecutionRole"
}
